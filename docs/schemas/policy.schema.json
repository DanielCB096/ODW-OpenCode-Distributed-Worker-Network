{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odw.local/schemas/policy.schema.json",
  "title": "ODW policy.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default", "rules"],
  "properties": {
    "version": { "const": 1 },
    "default": { "enum": ["AUTO", "ASK", "DENY"] },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "effect", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "effect": { "enum": ["AUTO", "ASK", "DENY"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "when": { "$ref": "#/$defs/when" }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["in", "out"] },
        "kind": { "$ref": "#/$defs/stringOrArray" },
        "mode": { "$ref": "#/$defs/stringOrArray" },
        "peer": { "$ref": "#/$defs/stringOrArray" },
        "peer_trust": { "$ref": "#/$defs/stringOrArray" },
        "repo": { "$ref": "#/$defs/stringOrArray" },
        "parent": { "type": "boolean" },
        "any_action": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "capabilities_all": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "capabilities_none": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_minutes": { "$ref": "#/$defs/range" },
            "max_memory_gb": { "$ref": "#/$defs/range" },
            "max_cost_usd": { "$ref": "#/$defs/range" },
            "network": { "enum": ["none", "allow"] }
          }
        },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["days", "from", "to"],
          "properties": {
            "days": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
            "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "tz": { "type": "string", "maxLength": 64 }
          }
        }
      }
    },
    "stringOrArray": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "items": { "type": "string" } }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "lte": { "type": "number" },
        "gte": { "type": "number" }
      }
    }
  }
}
